# Copy to .env and fill in. Generate each password with:
#   openssl rand -hex 24
# Passwords go into connection URLs, so keep them to letters and digits
# (hex is safe). They are applied to the database on its FIRST start only;
# changing them later needs ALTER ROLE in PostgreSQL as well.

POSTGRES_SUPERUSER_PASSWORD=
MONITOR_OWNER_PASSWORD=
MONITOR_APP_PASSWORD=
MONITOR_SYSTEM_PASSWORD=

# Key-encryption key for stored credentials (ADR-0006): 32 random bytes,
# base64. Generate with:  openssl rand -base64 32
# Back it up: losing it makes every stored device credential unrecoverable.
MONITOR_KEK=

# URL clients use to reach the API (shown in probe install instructions).
MONITOR_PUBLIC_URL=http://localhost:8443

# Where the API is published on the host. 127.0.0.1 keeps it local; set
# 0.0.0.0 only behind a firewall or a TLS-terminating proxy.
MONITOR_API_BIND=127.0.0.1
MONITOR_API_PORT=8443

# Image to run. The registry needs `docker login registry.plusclouds.com`
# unless the host is already logged in.
MONITOR_IMAGE=registry.plusclouds.com/monitoring
MONITOR_VERSION=0.1.2-m1

# external_source of tenants and users provisioned by the platform key.
MONITOR_IDENTITY_SOURCE=plusclouds
