{
  "uid": "monitor-device-overview",
  "title": "Device overview",
  "description": "Availability, incidents, checks and metrics of a tenant's devices (F07).",
  "tags": [
    "monitor",
    "devices"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
