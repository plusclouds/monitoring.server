    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "monitor-pg"
        },
        "query": "SELECT tenant_name AS __text, tenant_id::text AS __value FROM devices_v GROUP BY 1, 2 ORDER BY 1",
        "definition": "SELECT tenant_name AS __text, tenant_id::text AS __value FROM devices_v GROUP BY 1, 2 ORDER BY 1",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "monitor-pg"
        },
        "query": "SELECT name AS __text, id::text AS __value FROM devices_v WHERE tenant_id = '$tenant' ORDER BY name",
        "definition": "SELECT name AS __text, id::text AS __value FROM devices_v WHERE tenant_id = '$tenant' ORDER BY name",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "metric",
        "label": "Metric",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "monitor-pg"
        },
        "query": "SELECT DISTINCT name FROM metric_series_v WHERE device_id = '$device' ORDER BY 1",
        "definition": "SELECT DISTINCT name FROM metric_series_v WHERE device_id = '$device' ORDER BY 1",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0
