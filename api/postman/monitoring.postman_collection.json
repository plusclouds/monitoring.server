              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenantKey}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
