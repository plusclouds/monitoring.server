    {
      "name": "1. Provisioning (platform key)",
      "description": "What the PlusClouds API (leo4) calls when accounts and memberships change (ADR-0012). Idempotent: repeating a call with the same body changes nothing and writes no audit event.",
      "item": [
        {
          "name": "Create or update tenant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/tenants/by-external-id/{{tenantExternalId}}?source={{source}}",
            "description": "201 when created, 200 when updated or unchanged. Missing limits come from the platform defaults.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corp\",\n  \"limits\": {\n    \"max_devices\": 100,\n    \"api_rate_per_minute\": 1200\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200 or 201\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set(\"tenantId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List tenants",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/tenants?external_source={{source}}&limit=100",
            "description": "Reconciliation listing; follow `next_cursor` for more pages."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add member (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/tenants/{{tenantId}}/members/by-external-id/{{actorExternalId}}?source={{source}}",
            "description": "Creates the user mirror when needed. No personal data is stored.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\",\n  \"display_name\": \"Ayşe Yılmaz\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200 or 201\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/tenants/{{tenantId}}/members",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/users/by-external-id/{{actorExternalId}}?source={{source}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Ayşe Y.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suspend tenant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/tenants/by-external-id/{{tenantExternalId}}?source={{source}}",
            "description": "Reads keep working, writes return 403 tenant-suspended.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"suspended\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resume tenant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/tenants/by-external-id/{{tenantExternalId}}?source={{source}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Acting for a user (platform key)",
      "description": "The platform key acts in a tenant as a PlusClouds user, with that user's membership role. Unknown tenants and users are created just in time (users get read-only).",
      "item": [
        {
          "name": "Who am I (as user)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-External-ID",
                "value": "{{tenantExternalId}}"
              },
              {
                "key": "X-Actor-External-ID",
                "value": "{{actorExternalId}}"
              }
            ],
            "url": "{{baseUrl}}/v1/me",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"acts as the user\", () => pm.expect(pm.response.json().actor_kind).to.eql(\"user\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create tenant admin key (as user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-External-ID",
                "value": "{{tenantExternalId}}"
              },
              {
                "key": "X-Actor-External-ID",
                "value": "{{actorExternalId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/api-keys",
            "description": "The key is returned once. Saved as `tenantKey` for folder 3.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"tenantKey\", b.key);",
                  "pm.collectionVariables.set(\"tenantKeyId\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (as platform in tenant)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-External-ID",
                "value": "{{tenantExternalId}}"
              }
            ],
            "url": "{{baseUrl}}/v1/me",
            "description": "Without X-Actor-External-ID the platform has full rights in the tenant."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"platform role\", () => pm.expect(pm.response.json().role).to.eql(\"platform\"));"
                ]
              }
            }
          ]
        }
      ]
    },
