        {
          "name": "Delete tenant",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/v1/tenants/by-external-id/{{tenantExternalId}}?source={{source}}",
            "description": "Soft delete: the API returns 404 for it and data is purged after the grace period. A deleted external ID cannot be reused, so the next run gets a new `tenantExternalId`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
