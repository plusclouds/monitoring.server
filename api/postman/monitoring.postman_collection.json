{
  "info": {
    "_postman_id": "1a485852-e926-5aec-a07c-458920580cf8",
    "name": "Monitoring engine API",
    "description": "Requests for the monitoring engine REST API (`/v1`), the API reference and the status server.\n\n**Setup:** import `local.postman_environment.json`, run `monitor admin bootstrap` and put the printed platform key in `platformKey`. Run the folders in order: provisioning creates the tenant and member, *Acting for a user* creates `tenantKey`, and *Cleanup* removes what the run created.\n\nRequests save IDs and keys into collection variables for the next ones. The source of truth for every operation is `api/openapi.yaml`; the rendered reference is at `{{baseUrl}}/docs`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{platformKey}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A soft-deleted tenant's external ID cannot be reused, so each run (or each",
          "// round after Cleanup) works on a fresh tenant.",
          "if (!pm.collectionVariables.get(\"tenantExternalId\")) {",
          "  pm.collectionVariables.set(\"tenantExternalId\", \"acc-postman-\" + Date.now());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "tenantExternalId",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": ""
    },
    {
      "key": "tenantKey",
      "value": ""
    },
    {
      "key": "tenantKeyId",
      "value": ""
    },
    {
      "key": "extraKeyId",
      "value": ""
    },
    {
      "key": "auditCursor",
      "value": ""
    }
  ],
